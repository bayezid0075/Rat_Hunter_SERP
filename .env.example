# ---------------------------------------------------------------------------
# Universal SERP API - example environment configuration
# Copy to .env and change every secret before running in any shared environment.
# ---------------------------------------------------------------------------

APP_NAME="Universal SERP API"
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/v1
HOST=0.0.0.0
PORT=8000
WORKERS=4
LOG_LEVEL=INFO
LOG_JSON=true
REQUEST_ID_HEADER=X-Request-ID
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
ALLOWED_HOSTS=*
MAX_REQUEST_BODY_BYTES=1000000

# Secrets - MUST be changed outside local development.
SECRET_KEY=change-me-in-production
API_KEY_PEPPER=change-me-in-production-too

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://serp:serp@localhost:5432/serp
DATABASE_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
CACHE_BACKEND=redis
ENABLE_CACHE=true
SERP_CACHE_TTL=45
SERP_CACHE_STALE_TTL=90
PRODUCT_SERP_CACHE_TTL=20
PRODUCT_SERP_STALE_TTL=45
EXTRACTION_CACHE_TTL=180
EXTRACTION_STALE_TTL=600
WEBSITE_METADATA_TTL=3600
SOURCE_HEALTH_TTL=60
CACHE_LOCK_TIMEOUT=10

# API access
DEFAULT_RATE_LIMIT_PER_MINUTE=120
DEFAULT_DAILY_QUOTA=10000
API_KEY_CACHE_TTL=30

# Concurrency (all configurable, no code change required)
GLOBAL_SEARCH_CONCURRENCY=20
HTTP_EXTRACTION_CONCURRENCY=20
PER_ADAPTER_CONCURRENCY=5
PER_DOMAIN_CONCURRENCY=4
BROWSER_INSTANCES=2
BROWSER_PAGES_PER_INSTANCE=4
DISTRIBUTED_CONCURRENCY_TTL=60

# Deadlines / resilience
QUICK_SEARCH_TIMEOUT=8
DEEP_SEARCH_TIMEOUT=15
ADAPTER_TIMEOUT=6
EXTRACTION_TIMEOUT=8
GLOBAL_REQUEST_DEADLINE=20
SEARCH_RETRIES=1
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN=30

# Outbound HTTP extraction
HTTP_TIMEOUT=10
HTTP_CONNECT_TIMEOUT=5
HTTP_MAX_RESPONSE_BYTES=5000000
HTTP_MAX_REDIRECTS=5
HTTP_USER_AGENT="UniversalSerpBot/1.0 (+https://example.local/bot)"
HTTP_ALLOWED_PORTS=80,443
SSRF_ALLOW_PRIVATE=false
SSRF_DNS_TIMEOUT=3

# Google browser adapter (Playwright). No CAPTCHA bypass is attempted.
GOOGLE_ENABLED=true
GOOGLE_BASE_URL=https://www.google.com
GOOGLE_HEADLESS=true
GOOGLE_LOCALE=en-US
GOOGLE_REGION=US
GOOGLE_TIMEOUT_MS=15000
GOOGLE_NAVIGATION_TIMEOUT_MS=15000
GOOGLE_RESULTS_PER_PAGE=10
GOOGLE_MAX_PAGES=2
GOOGLE_SELECTORS_JSON=

# Direct website adapters / plugins
DIRECT_WEBSITES_ENABLED=false
DIRECT_WEBSITE_TIMEOUT=8
DIRECT_DARAZ_ENABLED=true
DIRECT_PICKABOO_ENABLED=true
DIRECT_STARTECH_ENABLED=true
DIRECT_GADGETANDGEAR_ENABLED=true

# Internal index adapter (PostgreSQL-backed documents; not an internet search engine)
CUSTOM_INDEX_ENABLED=true

# Ranking weights (JSON object, optional)
RANKING_WEIGHTS_JSON=

# Extraction
DEEP_SEARCH_EXTRACT_LIMIT=5
DEEP_SEARCH_EXTRACT_CONCURRENCY=5
BROWSER_FALLBACK=true
EXTRACTION_MAX_TEXT_CHARS=50000

# Observability
METRICS_ENABLED=true
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Background workers (ARQ queue names)
WORKER_SEARCH_QUEUE=serp:search
WORKER_EXTRACTION_QUEUE=serp:extraction
WORKER_BROWSER_QUEUE=serp:browser
JOB_MAX_RETRIES=2
JOB_TIMEOUT=120

# Create the first key with: python -m scripts.create_api_key --name "Local"
